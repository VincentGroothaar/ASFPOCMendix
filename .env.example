# Copy this file to .env and fill in the values. Never commit .env.
# Format: one KEY=value per line. Quotes and a leading "export" are allowed.

# SAP OData V2 sandbox
SAP_BASE_URL=https://sandbox.api.sap.com
SAP_API_KEY=

# Plants offered on the order list, comma-separated; the first is the default.
COCKPIT_PLANTS=AUC1

# Purchase requisition mock (the only POST target). MOCK_API_KEY is the key the mock
# expects and the Cockpit sends; see mock_pr/README.md. MOCK_PR_BASE_URL is the host only,
# without /sap/opu/... (a URL ending in the service path also works). Locally e.g. http://localhost:8001
MOCK_PR_BASE_URL=
MOCK_API_KEY=

# Database: Postgres everywhere. `docker compose up -d` starts it with the
# POSTGRES_* values below. These are local-only values; never reuse them in a
# shared environment. Percent-encode special characters in a password, e.g. @ as %40.
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=cockpit
POSTGRES_DB=cockpit
DATABASE_URL=postgresql://cockpit:cockpit@localhost:5432/cockpit

# Django. The values below are for local development only.
# In any shared environment: set a long random DJANGO_SECRET_KEY, set DJANGO_DEBUG=false,
# and list the real host names in DJANGO_ALLOWED_HOSTS.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# true only when hosted behind an HTTPS proxy (Render): HTTPS-only cookies and redirects.
DJANGO_HTTPS=false

# Passwords of the five PoC accounts, read by `manage.py create_test_users`. Each must pass
# Django's password rules (8+ characters, not common, not only digits). Leave empty in git.
TEST_PASSWORD_VIEWER=
TEST_PASSWORD_PLANNER=
TEST_PASSWORD_MANAGER_A=
TEST_PASSWORD_MANAGER_B=
TEST_PASSWORD_ADMIN=
